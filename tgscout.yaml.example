# Example config for tgscout. Copy it to tgscout.yaml and put your own values in.
# Every request and chat below is made up. Secrets (api_id, api_hash, the
# session) never go here: they live in .env and the session file.

# The Telegram user tgscout writes to: @username or a numeric ID.
owner: "@your_username"

# Matcher workers that ask the LLM at the same time (default 2).
workers: 2

# Messages that may wait for the LLM (default 1000). When the queue is full,
# tgscout waits before it takes more messages from Telegram; none is dropped.
queue_size: 1000

# Longest pause between two tries of LM Studio or of a send to you (default
# 60s). Pauses start at 1s and double; no message is dropped while it waits.
retry_max_pause: 60s

# How long Ctrl+C waits for the messages in work before tgscout stops
# (default 10s). A second Ctrl+C stops at once.
stop_grace: 10s

# How often tgscout prints its status line: messages in, judged, matches,
# queue length and the p95 times (default 5m, at least 10s). It prints the
# status since start once more at the stop.
status_interval: 5m

# Pause between two history reads from Telegram at catch-up and after a
# reconnect (default 1s, 0s turns it off).
history_pause: 1s

# LM Studio, through its OpenAI-compatible API.
lm_studio:
  url: http://localhost:1234/v1   # default
  model: qwen2.5-7b-instruct      # required: the model LM Studio serves
  timeout: 60s                    # default

# How far back tgscout reads each chat at start (defaults 500 and 3).
# A request, and a chat of that request, may override it; the nearest wins.
catch_up:
  messages: 500
  days: 3

# Standing requests: what to look for and in which chats.
# A chat is "@username", a public "https://t.me/name" link, or the numeric ID
# of a private chat.
requests:
  - id: kids-bike
    find: a kids bike, 16 inch, under 100 EUR
    catch_up: {days: 7}            # this request only
    chats:
      - "@example_flea_market"
      - ref: "https://t.me/example_neighbours"
        catch_up: {messages: 2000} # this chat of this request only
  - id: desk-lamp
    find: a desk lamp with a clamp
    chats:
      - "@example_flea_market"
      - -1001234567890
