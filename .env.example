# Telegram account of tgscout (MTProto). Fill in a local .env; never commit it.
# The app id of tgscout's account, a number, from my.telegram.org → API development tools.
TG_API_ID=
# The app hash from the same page.
TG_API_HASH=
# Where the session is saved (mode 600); empty means tgscout.session next to the config.
TG_SESSION_FILE=
